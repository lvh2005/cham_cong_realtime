# =======================================================
# HỆ THỐNG CHẤM CÔNG NHẬN DIỆN KHUÔN MẶT (FACE ATTENDANCE)
# Cấu hình biến môi trường (Environment Variables)
# =======================================================

# 1. CẤU HÌNH MICROSOFT SQL SERVER
DB_SERVER=DESKTOP-FLMIP09
DB_DATABASE=FaceAttendanceDB
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_USER=sa
DB_PASSWORD=

# 2. CẤU HÌNH CLOUDINARY (LƯU ẢNH NHÂN VIÊN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=face_attendance/employees

# 3. THAM SỐ NHẬN DIỆN & THUẬT TOÁN FAISS
# Khoảng cách L2 threshold để công nhận trùng khuôn mặt (càng nhỏ càng chặt, khuyến nghị: 0.35 - 0.40)
FACE_MATCH_THRESHOLD=0.38

# Khoảng cách L2 để phát hiện đăng ký trùng người khác (khuyến nghị: <= 0.35)
FACE_DUPLICATE_THRESHOLD=0.35

# Độ chênh lệch giữa Top 1 và Top 2. Nếu |Top2 - Top1| < Margin -> Trạng thái AMBIGUOUS (người giống nhau)
FACE_AMBIGUOUS_MARGIN=0.05

# Thời gian cooldown chống chấm công liên tục cho cùng một người (giây)
ATTENDANCE_COOLDOWN_SECONDS=60

# Số frame bỏ qua giữa các lần nhận diện AI ngầm (giúp giảm tải CPU)
RECOGNITION_FRAME_SKIP=3

# 4. CẤU HÌNH FLASK WEB ADMIN
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_SECRET_KEY=face_attendance_flask_secret_2026_key

